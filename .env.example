# Go backend environment example - DO NOT put real secrets here.
# Copy to .env.local or configure in deployment platform secrets.

# Server
PORT=8080
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:3000
ALLOW_VERCEL_PREVIEW=false
WS_MAX_CONNECTIONS=500

# Admin
ADMIN_TOKEN=
ADMIN_AUDIT_LOG=logs/admin-audit.log
ADMIN_AUTH_MAX_FAILS=5
ADMIN_AUTH_LOCK_MINUTES=10
ADMIN_ALERT_WEBHOOK_URL=

# Data / cache
DATA_BACKEND=file
DATABASE_URL=
REDIS_ADDR=
REDIS_PASSWORD=
REDIS_TLS=false

# External APIs
RAPIDAPI_KEY=
RAPIDAPI_HOST=
APIFOOTBALL_KEY=
APIFOOTBALL_API_BASE=
APIFOOTBALL_DAILY_LIMIT=
GOAL_API_KEY=
GOAL_API_BASE=
GOAL_DAILY_LIMIT=
GOAL_LIST_TTL_MIN=
GOAL_LIVE_TTL_SEC=
GOAL_LIVE_SWEEP_SEC=
WARMUP_LEAGUES=

# Auth / push / notifications
GOOGLE_CLIENT_ID=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
FCM_ACCESS_TOKEN=
FCM_SERVER_KEY=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TARGET_ID=

# Alerts / SMTP
ALERT_TELEGRAM_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Rate limiting
RATE_LIMIT_SCALE=1
